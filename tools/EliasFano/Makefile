CXX = g++
BOOST_INCLUDE ?= /opt/homebrew/Cellar/boost/1.90.0_1/include
INCLUDES = -I2i_bench/include -I2i_bench/external $(if $(wildcard $(BOOST_INCLUDE)),-I$(BOOST_INCLUDE),)
CXXFLAGS = -std=c++17 -Wall -Wextra -O2 -DBOOST_TIMER_ENABLE_DEPRECATED $(INCLUDES)
TARGET = EliasFano
SOURCES = EliasFano.cpp
OBJECTS = $(SOURCES:.cpp=.o)
# Configuration header of succinct, normally generated by its cmake (with its default options)
SUCCINCT_CONFIG = 2i_bench/external/succinct/succinct_config.hpp

all: $(TARGET)

$(TARGET): $(OBJECTS)
	$(CXX) $(CXXFLAGS) -o $@ $^

%.o: %.cpp $(SUCCINCT_CONFIG)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(SUCCINCT_CONFIG): $(SUCCINCT_CONFIG).in
	sed -e 's|^#cmakedefine SUCCINCT_USE_INTRINSICS 1|#define SUCCINCT_USE_INTRINSICS 1|' \
	    -e 's|^#cmakedefine \(SUCCINCT_USE_[A-Z]*\) 1|/* #undef \1 */|' $< > $@

clean:
	rm -f $(OBJECTS) $(TARGET) $(SUCCINCT_CONFIG)

.PHONY: all clean
